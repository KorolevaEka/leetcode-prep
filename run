#!/bin/sh
# ./run test            — тесты платформы (pytest + node --test)
# ./run verify [путь]   — проверка задач (эталон проходит, мутанты падают)
case "$1" in
  test) exec docker compose exec -T py sh -c 'pytest tests/test_build.py -q && node --test tests/' ;;
  verify) shift; exec docker compose exec -T py node scripts/verify.mjs "$@" ;;
  *) echo "usage: ./run test | ./run verify [путь]"; exit 1 ;;
esac
